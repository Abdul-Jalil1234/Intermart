# =============================================================================
#  STORE BRANDING  -  change these values to rebrand the store for another shop.
#  No code changes needed. Replace public/logo.png (or set NEXT_PUBLIC_COMPANY_LOGO).
# =============================================================================

# --- Identity ---------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME=Intermart
# Branch name, shown after the name ("Intermart Mahogany"). Leave blank for no branch.
NEXT_PUBLIC_COMPANY_BRANCH=Mahogany
NEXT_PUBLIC_COMPANY_TAGLINE="Fresh groceries and everyday essentials, delivered to your door"
NEXT_PUBLIC_COMPANY_DESCRIPTION="Shop online at Intermart Mahogany: fresh produce, groceries, household essentials and more at great prices."
# Logo: a path under /public (default /logo.png) or a full https:// URL, plus its pixel size.
NEXT_PUBLIC_COMPANY_LOGO=/logo.png
NEXT_PUBLIC_COMPANY_LOGO_WIDTH=738
NEXT_PUBLIC_COMPANY_LOGO_HEIGHT=270

# --- Contact details (used on Contact page, footer, emails, SEO) -------------
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_BUSINESS_HOURS_WEEKDAY="Monday - Saturday: 8AM - 8PM"
NEXT_PUBLIC_COMPANY_BUSINESS_HOURS_WEEKEND="Sunday: 8AM - 1PM"
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_CONTACT_RESPONSE_TIME="We reply within 24 hours"
NEXT_PUBLIC_QUICK_RESPONSE_TIME="2-4 hours during business hours"
# ISO country code for SEO (MU = Mauritius)
NEXT_PUBLIC_COUNTRY_CODE=MU
# Shown in the footer. Leave blank to use "© <year> <store name>. All rights reserved."
NEXT_PUBLIC_COPYRIGHT_TEXT=
NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy
NEXT_PUBLIC_TERMS_URL=/terms

# --- Social media (optional; leave blank to hide) -----------------------------
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# --- Brand colours (defaults match the Intermart red and black logo) ---------
NEXT_PUBLIC_BRAND_PRIMARY=#e00024
NEXT_PUBLIC_BRAND_PRIMARY_HOVER=#b8001d
NEXT_PUBLIC_BRAND_DARK=#111111
NEXT_PUBLIC_BRAND_DARK_HOVER=#2b2b2b
NEXT_PUBLIC_BRAND_ACCENT=#ff5a36
NEXT_PUBLIC_BRAND_TINT=#fdeced
NEXT_PUBLIC_BRAND_PRIMARY_SOFT=#f6a5ab

# --- Currency, shipping and price filter -------------------------------------
# ISO 4217 code (USD, MUR, EUR ...). It must be supported by your Stripe account.
NEXT_PUBLIC_CURRENCY_CODE=USD
# Number formatting locale (en-US, en-MU, fr-FR ...)
NEXT_PUBLIC_LOCALE=en-US
# Orders above this subtotal ship free; otherwise the flat fee applies.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=100
NEXT_PUBLIC_SHIPPING_FEE=10
# Upper bounds for the shop price filter, comma separated
NEXT_PUBLIC_PRICE_BREAKPOINTS=100,200,300,500

# --- Notifications: how often (seconds) the header bell checks for new ones. 0 = off
NEXT_PUBLIC_NOTIFICATION_POLL_SECONDS=15

# --- Email sender name (defaults to the store name + branch) -----------------
NEXT_PUBLIC_EMAIL_SENDER_NAME=

# =============================================================================
#  APPLICATION SETTINGS
# =============================================================================
# Your live site URL, e.g. https://your-store.vercel.app (http://localhost:3000 locally)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated admin emails. These people get /admin access.
NEXT_PUBLIC_ADMIN_EMAIL=
TAX_AMOUNT=

# Sanity (CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-11-09
# Editor (write) token - needed for admin product management and the seed script
SANITY_API_TOKEN=
SANITY_API_READ_TOKEN=

# Clerk (authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Stripe (payments)
STRIPE_SECRET_KEY=
# Local webhook testing: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=

# Reward and loyalty points
REWARD_POINTS_THRESHOLD=
REWARD_POINTS_AMOUNT=
LOYALTY_POINTS_ORDER_THRESHOLD=
LOYALTY_POINTS_AMOUNT=

# Spin & Win wheel
# Long random string used to sign the spin cookie (e.g. openssl rand -hex 32)
WHEEL_SECRET=
# Most expensive product (in store currency) the wheel may give away. Default 50.
WHEEL_MAX_PRIZE_PRICE=

# Email sending (Gmail OAuth2). Get the refresh token at https://developers.google.com/oauthplayground
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SENDER_EMAIL_ADDRESS=

# Optional integrations (leave blank to disable)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Seed script only: real product photos (https://pixabay.com/api/docs/ or https://unsplash.com/developers)
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
PHOTO_PROVIDER=

# ---------------------------------------------------------------------------
# About page – leadership team (all optional; default is a neutral SVG avatar)
# To use a photo: put it in public/images/team/ and set e.g. /images/team/ceo.jpg
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TEAM_CEO_NAME=
NEXT_PUBLIC_TEAM_CEO_ROLE=
NEXT_PUBLIC_TEAM_CEO_DESCRIPTION=
NEXT_PUBLIC_TEAM_CEO_IMAGE=
NEXT_PUBLIC_TEAM_CTO_NAME=
NEXT_PUBLIC_TEAM_CTO_ROLE=
NEXT_PUBLIC_TEAM_CTO_DESCRIPTION=
NEXT_PUBLIC_TEAM_CTO_IMAGE=
NEXT_PUBLIC_TEAM_DESIGN_NAME=
NEXT_PUBLIC_TEAM_DESIGN_ROLE=
NEXT_PUBLIC_TEAM_DESIGN_DESCRIPTION=
NEXT_PUBLIC_TEAM_DESIGN_IMAGE=
